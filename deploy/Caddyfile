# RemindMe 反向代理：{$DOMAIN} 從 deploy/.env 帶入（例如 remindme-xxx.duckdns.org）。
# Caddy 會自動向 Let's Encrypt 申請並續期 HTTPS 憑證，HTTP 會自動轉址到 HTTPS。
# 憑證存在 caddy_data volume，重建容器不會重新申請。

{$DOMAIN} {
	encode gzip zstd

	# 轉給後端；Caddy 會自動帶上 X-Forwarded-For / X-Forwarded-Proto
	reverse_proxy backend:3000

	log {
		output stdout
		format console
	}
}
