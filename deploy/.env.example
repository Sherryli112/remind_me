# RemindMe 正式環境設定。在 VM 上：
#   cp deploy/.env.example deploy/.env && nano deploy/.env
# deploy/.env 含有密碼與密鑰，絕對不要 commit（已被 .gitignore 的 `.env` 規則排除）。

# 你的 DuckDNS 網域（不含 https://），A 記錄要指向 VM 的公開 IP
DOMAIN=remindme-xxx.duckdns.org

# PostgreSQL 密碼。請用下面的指令產生（hex 只含 0-9a-f，放進連線字串不需要跳脫）：
#   openssl rand -hex 32
POSTGRES_PASSWORD=change-me-run-openssl-rand-hex-32

# access token 簽章密鑰，至少 32 字元。請用下面的指令產生：
#   openssl rand -base64 48
# 注意：更換這個值會讓所有人的 access token 立即失效（refresh token 不受影響，會自動換新的 access token）
JWT_ACCESS_SECRET=change-me-run-openssl-rand-base64-48

# access token 有效期
JWT_ACCESS_TTL=15m

# refresh token 有效天數
REFRESH_TOKEN_TTL_DAYS=30

# 允許的 CORS Origin，逗號分隔。正式環境只有桌面版（Tauri webview）會呼叫
CORS_ORIGINS=http://tauri.localhost,tauri://localhost
