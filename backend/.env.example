# 本機開發用環境變數。複製成 .env 後依需要修改：cp .env.example .env
# 後端會依序讀 ../.env（根目錄）與 backend/.env，同一個變數以先讀到的為準。
# 先用 `docker compose up -d db`（專案根目錄）起本機 PostgreSQL。

# PostgreSQL 連線字串（對應根目錄 docker-compose.yml 的 db：帳密 postgres/postgres、資料庫 remindme）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/remindme?schema=public

# access token 的 HS256 簽章密鑰，至少 32 字元；正式環境請用 `openssl rand -base64 48` 產生
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef

# access token 有效期（vercel/ms 格式，例如 15m、1h）
JWT_ACCESS_TTL=15m

# refresh token 有效天數
REFRESH_TOKEN_TTL_DAYS=30

# 允許的 CORS Origin，逗號分隔（本機 Next dev server + Tauri webview）
CORS_ORIGINS=http://localhost:3001,http://tauri.localhost,tauri://localhost

# 後端監聽埠
PORT=3000
