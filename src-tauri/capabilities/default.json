{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main", "popup-*"],
  "permissions": [
    "core:default",
    "core:tray:allow-new",
    "core:tray:allow-set-icon",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide"
  ]
}
